@model IsintuWebsite.Models.OrderFormViewModel
@using System.Web.Mvc
@using System.Collections.Generic

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Title {
    @Model.Attire.Name
}

<div class="details-page">
    <div class="details-image">
        <img src="@Url.Content(Model.Attire.ImageUrl)" alt="@Model.Attire.Name" />
    </div>

    <div class="details-info">
        <h1>@Model.Attire.Name</h1>
        <p class="attire-meta">@Model.Attire.Category &bull; @Model.Attire.Size &bull; @Model.Attire.Color &bull; @Model.Attire.Material</p>
        <p>@Model.Attire.Description</p>

        <p class="attire-price">
            Buy for R@Model.Attire.BuyPrice.ToString("N2")
            &nbsp;|&nbsp;
            Rent from R@Model.Attire.RentPricePerDay.ToString("N2") per day
        </p>

        @using (Html.BeginForm("PlaceOrder", "Attire", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.AttireId)
            @Html.ValidationSummary(true, "", new { @class = "validation-summary" })

            <div class="form-row">
                @Html.LabelFor(m => m.OrderType)
                @Html.DropDownListFor(m => m.OrderType, new List<SelectListItem>
                {
                    new SelectListItem { Text = "Buy", Value = "Buy" },
                    new SelectListItem { Text = "Rent", Value = "Rent" }
                })
            </div>

            <div class="form-row">
                @Html.LabelFor(m => m.Quantity)
                @Html.TextBoxFor(m => m.Quantity, new { type = "number", min = "1", max = "10" })
            </div>

            <div class="form-row">
                @Html.LabelFor(m => m.RentalDays)
                @Html.TextBoxFor(m => m.RentalDays, new { type = "number", min = "1", max = "30" })
                <span class="field-hint">Only used if you choose to Rent.</span>
            </div>

            <div class="form-row form-row-checkbox">
                @Html.CheckBoxFor(m => m.IncludeAccessories)
                @Html.LabelFor(m => m.IncludeAccessories)
            </div>

            <hr />

            <div class="form-row">
                @Html.LabelFor(m => m.CustomerName)
                @Html.TextBoxFor(m => m.CustomerName)
            </div>

            <div class="form-row">
                @Html.LabelFor(m => m.CustomerEmail)
                @Html.TextBoxFor(m => m.CustomerEmail, new { type = "email" })
            </div>

            <div class="form-row">
                @Html.LabelFor(m => m.CustomerPhone)
                @Html.TextBoxFor(m => m.CustomerPhone)
            </div>

            <div class="form-row">
                @Html.LabelFor(m => m.DeliveryAddress)
                @Html.TextAreaFor(m => m.DeliveryAddress, new { rows = 3 })
            </div>

            <button type="submit" class="btn-primary">Place Order</button>
        }
    </div>
</div>
