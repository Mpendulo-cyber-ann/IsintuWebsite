@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Title {
    About Us
}

<div class="about-page">
    <h1>About Isintu</h1>
    <p>
        Isintu was built to bring traditional South African attire out of local foot traffic and
        onto a platform anyone can reach, anywhere in the world. What used to depend entirely on
        cash sales and word of mouth now has a proper online home - customers can browse, book,
        pay, and track their order without ever needing to visit in person.
    </p>
    <p>
        Whether you're buying a set to keep or hiring one for a wedding or cultural event, Isintu
        handles the booking, the payment and the delivery, so the only thing left for you to worry
        about is looking good on the day.
    </p>
</div>
