<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@RenderSection("Title", required: false) - Isintu Traditional Attire</title>
    <link href="~/Content/site.css" rel="stylesheet" type="text/css" />
</head>
<body>
    <header class="site-header">
        <div class="site-header-inner">
            <a class="site-brand" href="@Url.Action("Index", "Home")">Isintu</a>
            <nav class="site-nav">
                <a href="@Url.Action("Index", "Home")">Home</a>
                <a href="@Url.Action("Index", "Attire")">Shop Attire</a>
                <a href="@Url.Action("About", "Home")">About Us</a>
            </nav>
        </div>
    </header>

    <div class="container">
        @RenderBody()
    </div>

    <footer class="site-footer">
        <p>&copy; @DateTime.Now.Year Isintu Traditional Attire. Bridging heritage and technology.</p>
    </footer>
</body>
</html>
