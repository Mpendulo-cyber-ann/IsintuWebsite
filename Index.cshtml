@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Title {
    Home
}

<div class="hero">
    <h1>Isintu Traditional Attire</h1>
    <p>Bridging heritage and technology - browse, buy or hire authentic South African traditional attire, delivered anywhere.</p>
    <a class="btn-primary" href="@Url.Action("Index", "Attire")">Shop Our Collection</a>
</div>

<div class="info-strip">
    <div class="info-card">
        <h3>Buy</h3>
        <p>Own a full traditional attire set from R5,400.</p>
    </div>
    <div class="info-card">
        <h3>Rent</h3>
        <p>Hire attire for your event from just R340 per day.</p>
    </div>
    <div class="info-card">
        <h3>Delivered</h3>
        <p>We deliver and collect, wherever you are.</p>
    </div>
</div>
